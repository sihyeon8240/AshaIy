{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "inputs",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "config/image-build.json"
      },
      "items": {
        "type": "string",
        "$comment": "validation-pattern: relative_path",
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arch",
          "runner"
        ],
        "properties": {
          "arch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "runner": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        }
      },
      "contains": {
        "properties": {
          "arch": {
            "const": "amd64"
          }
        }
      }
    }
  }
}
