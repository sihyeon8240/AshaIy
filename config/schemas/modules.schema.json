{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Modules manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$",
        "not": {
          "const": "All"
        },
        "$comment": "validation-pattern: lean_name"
      },
      "uniqueItems": true
    }
  }
}
