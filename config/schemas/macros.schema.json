{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository LaTeX macros",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "macros"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "macros": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
            "$ref": "#/$defs/operator"
          },
          {
            "$ref": "#/$defs/paired"
          },
          {
            "$ref": "#/$defs/paired_x"
          }
        ]
      }
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "math",
        "text",
        "opaque"
      ]
    },
    "mandatory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode"
      ],
      "properties": {
        "kind": {
          "const": "mandatory"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        }
      }
    },
    "optional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "default"
      ],
      "properties": {
        "kind": {
          "const": "optional"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "default": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "arguments",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "context": {
          "enum": [
            "math",
            "text",
            "any"
          ]
        },
        "arguments": {
          "type": "array",
          "maxItems": 9,
          "prefixItems": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/mandatory"
                },
                {
                  "$ref": "#/$defs/optional"
                }
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/mandatory"
          }
        },
        "body": {
          "type": "string"
        },
        "script_atom": {
          "type": "boolean"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "operator"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "boolean"
        },
        "script_atom": {
          "type": "boolean"
        }
      }
    },
    "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "paired_delimiter"
        },
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "script_atom": {
          "type": "boolean"
        }
      }
    },
    "paired_x": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "right",
        "arguments",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "paired_delimiter_x"
        },
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/mandatory"
          }
        },
        "body": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "script_atom": {
          "type": "boolean"
        }
      }
    }
  }
}
