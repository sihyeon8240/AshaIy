{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shell_args",
    "test_directory",
    "test_pattern"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "shell_args": {
      "type": "array",
      "prefixItems": [
        {
          "const": "-ln"
        },
        {
          "const": "bash"
        },
        {
          "const": "-i"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ],
      "items": {
        "enum": [
          "-ci",
          "-sr"
        ]
      },
      "minItems": 4,
      "maxItems": 6,
      "uniqueItems": true
    },
    "test_directory": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.*-]+$"
    },
    "test_pattern": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.*-]+$"
    }
  }
}
