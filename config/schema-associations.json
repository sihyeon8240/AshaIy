{
  "schema_version": 1,
  "yaml": {
    "config/schemas/macros.schema.json": [
      "/common/styles/macros.yml",
      "/books/*/styles/macros.yml"
    ],
    "config/schemas/books.schema.json": [
      "/config/books.yml"
    ],
    "config/schemas/chapters.schema.json": [
      "/books/*/chapters.yml"
    ],
    "config/schemas/sections.schema.json": [
      "/books/*/chapters/*/sections.yml",
      "/books/*/appendices/*/sections.yml"
    ],
    "config/schemas/modules.schema.json": [
      "/lean/Textbooks/**/modules.yml"
    ],
    "config/schemas/latexindent.schema.json": [
      "/config/latexindent.yaml"
    ],
    "config/schemas/proofs.schema.json": [
      "/books/*/chapters/*/proofs.yml",
      "/books/*/appendices/*/proofs.yml"
    ]
  },
  "json": {
    "config/schemas/authoring.schema.json": [
      "/config/authoring.json"
    ],
    "config/schemas/image-build.schema.json": [
      "/config/image-build.json"
    ],
    "config/schemas/validation-patterns.schema.json": [
      "/config/validation-patterns.json"
    ]
  }
}
