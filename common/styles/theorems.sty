\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorems}[2026/11/13 Theorem environments and reference names]

% Direct dependencies: keep this module safe to load independently.
\RequirePackage{amsthm}
\RequirePackage[nameinlink]{cleveref}

% Before a list opens its group, @currenvir still names its parent. Only flush a pending theorem/proof heading; ordinary
% prose has cleared @inlabel.
\newcommand*{\textbook@breakbeforelist}[1]{%
  \@ifundefined{textbook@listhead@\@currenvir}{}{%
    \if@inlabel
      % Let the list end this paragraph so it uses the same topsep as after prose.
      \leavevmode
      \AddToHookNext{env/#1/begin}{%
        \@nobreaktrue
        % The kernel's no-break item normally suppresses topsep after headings. Keep the page-break protection while
        % retaining the list's own spacing.
        \def\@nbitem{%
          \nobreak
          \addvspace\@topsep
          \addvspace{-\parskip}%
        }%
      }%
    \fi
  }%
}

\RequirePackage{generated-theorems}
