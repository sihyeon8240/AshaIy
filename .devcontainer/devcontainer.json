{
  "name": "AshaIy",
  "init": true,
  "waitFor": "postCreateCommand",
  "image": "ghcr.io/sihyeon8240/ashaiy@sha256:63169cd572a8eb0d254d2c8e654aa8dfc78df4bed3c8763ded0fb7f01dc6fad9",
  "containerEnv": {
    "PYTHONPYCACHEPREFIX": "${containerWorkspaceFolder}/.cache/python",
    "MATHLIB_CACHE_DIR": "${containerWorkspaceFolder}/.cache/mathlib",
    "TEXINPUTS": ".:${containerWorkspaceFolder}/common/styles//:${containerWorkspaceFolder}/common/templates//:",
    "ASHAIY_ROOT": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "./scripts/ashaiy doctor env",
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "github.vscode-github-actions",
        "leanprover.lean4",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "mkhl.shfmt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "ruff.path": [
          "/usr/local/bin/ruff"
        ]
      }
    }
  },
  "forwardPorts": [
    4000
  ],
  "portsAttributes": {
    "4000": {
      "label": "Site preview",
      "onAutoForward": "notify"
    }
  }
}
