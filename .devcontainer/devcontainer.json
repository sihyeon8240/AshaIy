{
  "name": "AshaIy",
  "init": true,
  "waitFor": "postCreateCommand",
  "appPort": [
    "127.0.0.1:${localEnv:ASHAIY_PREVIEW_PORT:4000}:4000"
  ],
  "image": "ghcr.io/sihyeon8240/ashaiy@sha256:b5571c25d6c9e5a74ed38ae5e2598a936afad43b66ca99368b21513950335eb7",
  "containerEnv": {
    "PYTHONPYCACHEPREFIX": "${containerWorkspaceFolder}/.cache/python",
    "MATHLIB_CACHE_DIR": "${containerWorkspaceFolder}/.cache/mathlib",
    "TEXINPUTS": ".:${containerWorkspaceFolder}/common/styles//:${containerWorkspaceFolder}/common/templates//:",
    "ASHAIY_ROOT": "${containerWorkspaceFolder}",
    "ASHAIY_SITE_HOST": "0.0.0.0"
  },
  "postCreateCommand": "./scripts/ashaiy doctor env",
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "github.vscode-github-actions",
        "leanprover.lean4",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "mkhl.shfmt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "ruff.path": [
          "/usr/local/bin/ruff"
        ]
      }
    }
  },
  "forwardPorts": [
    4000
  ],
  "portsAttributes": {
    "4000": {
      "label": "Site preview",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=ashaiy-${devcontainerId}-lake-v4.35.0,target=${containerWorkspaceFolder}/lean/.lake,type=volume,volume-nocopy",
    "source=ashaiy-${devcontainerId}-cache-v1,target=${containerWorkspaceFolder}/.cache,type=volume,volume-nocopy",
    "source=ashaiy-${devcontainerId}-hypothesis-v1,target=${containerWorkspaceFolder}/.hypothesis,type=volume,volume-nocopy"
  ]
}
