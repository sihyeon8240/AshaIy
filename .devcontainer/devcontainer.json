{
  "name": "AshaIy",
  "image": "ghcr.io/sihyeon8240/ashaiy@sha256:f0b958ad78dc3a10a87e9448d4cf3669e2909deb5d6f05e8b83b4575df85ab81",
  "containerEnv": {
    "PYTHONPYCACHEPREFIX": "${containerWorkspaceFolder}/.cache/python",
    "MATHLIB_CACHE_DIR": "${containerWorkspaceFolder}/.cache/mathlib",
    "TEXINPUTS": ".:${containerWorkspaceFolder}/common/styles//:${containerWorkspaceFolder}/common/templates//:",
    "ASHAIY_ROOT": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "./scripts/setup_cli.sh && ./scripts/check_environment.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "github.vscode-github-actions",
        "leanprover.lean4",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "mkhl.shfmt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "ruff.path": [
          "/usr/local/bin/ruff"
        ]
      }
    }
  },
  "forwardPorts": [
    4000
  ],
  "portsAttributes": {
    "4000": {
      "label": "Site preview",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.cache/bin:${containerEnv:PATH}"
  }
}
