    },
    {
      "label": "ashaiy format sh --check (current file)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "format",
        "sh",
        "--check",
        "--file",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ashaiy site build",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "site",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ashaiy site serve",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "site",
        "serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "site-preview",
        "pattern": {
          "regexp": "^(.+): (error|warning): (.+)$",
          "kind": "file",
          "file": 1,
          "severity": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Configuration file:",
          "endsPattern": "^Preview: http://localhost:"
        }
      },
      "isBackground": true
    },
    {
      "label": "ashaiy site test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "site",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "book",
      "type": "pickString",
      "description": "Textbook from config/books.yml (run ashaiy config generate after changing the manifest)",
      "options": [
        "mathematical-analysis",
        "elementary-number-theory",
        "linear-algebra"
      ]
    }
  ],
  "problemMatcher": [
    {
      "owner": "repository",
      "source": "repository",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}"
      ],
      "pattern": {
        "regexp": "^([^:]+): (error|warning): (.+)$",
        "kind": "file",
        "file": 1,
        "severity": 2,
        "message": 3
      }
    },
    {
      "owner": "format",
      "source": "format",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}"
      ],
      "pattern": {
        "regexp": "^(?:\\[tex\\] needs formatting: |needs whitespace normalization: |Would reformat: )(.+)$",
        "kind": "file",
        "file": 1,
        "message": 0
      }
    },
    {
      "owner": "ruff",
      "source": "ruff",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}"
      ],
      "pattern": {
        "regexp": "^(.+?):(\\d+):(\\d+): (.+)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "message": 4
      }
    },
    {
      "owner": "lean",
      "source": "lean",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}/lean"
      ],
      "pattern": {
        "regexp": "^(.+?\\.lean):(\\d+):(\\d+): (error|warning|info): (.+)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "message": 5
      }
    },
    {
      "owner": "latex",
      "source": "latex",
      "fileLocation": [
        "search",
        {
          "include": [
            "${workspaceFolder}/books",
            "${workspaceFolder}/common"
          ]
        }
      ],
      "pattern": {
        "regexp": "^(.+?\\.(?:tex|sty|cls)):(\\d+): (?:(error|warning): )?(.+)$",
        "file": 1,
        "line": 2,
        "message": 4,
        "severity": 3
      }
    },
    {
      "owner": "shell-format",
      "source": "shfmt",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}"
      ],
      "pattern": {
        "regexp": "^diff (.+)\\.orig (.+)$",
        "kind": "file",
        "file": 2,
        "message": 0
      }
    },
    {
      "owner": "lean-build",
      "source": "lean",
      "fileLocation": [
        "autoDetect",
        "${workspaceFolder}/lean"
      ],
      "pattern": {
        "regexp": "^(error|warning|info): (.+?\\.lean):(\\d+):(\\d+): (.+)$",
        "severity": 1,
        "file": 2,
        "line": 3,
        "column": 4,
        "message": 5
      }
    }
  ]
}
