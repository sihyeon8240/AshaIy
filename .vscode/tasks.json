      }
    },
    {
      "label": "ashaiy format tex (current file)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "format",
        "tex",
        "--file",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ashaiy format tex --check (current file)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "format",
        "tex",
        "--check",
        "--file",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ashaiy format py (current file)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "format",
        "py",
        "--file",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ashaiy format py --check (current file)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/ashaiy",
        "format",
